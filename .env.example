# ==============================================================================
# Tuğla — environment template
# Copy to .env and fill in. Blank values are treated as "not configured":
# the related feature stays off and the UI says so instead of faking it.
# Generate strong secrets with: node scripts/generate-secrets.mjs
# ==============================================================================

# ----- identity / branding (single source for the whole product) --------------
APP_NAME=Tuğla.fun
APP_SLUG=tugla
APP_TAGLINE=Tuğlaları kır
ROOT_DOMAIN=tugla.fun
WEB_URL=http://localhost:3000
# Üretim / production: https://tugla.fun
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
# Values inlined into browser bundles at build time:
NEXT_PUBLIC_APP_NAME=Tuğla.fun
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_ENVIRONMENT=development

# ----- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Dokploy/Traefik = 1)
TRUST_PROXY=0
# Per-IP request throttling. Mobile carriers put many players behind one
# address, so keep these generous; the API answers 429 above them.
RATE_LIMIT_BURST=30
RATE_LIMIT_BURST_SECONDS=1
RATE_LIMIT_SUSTAINED=1200
RATE_LIMIT_SUSTAINED_SECONDS=60
# Multiplier for auth-specific limits (registration, login, password reset).
# Keep this at 1 in production; automated test suites raise it locally.
AUTH_RATE_LIMIT_FACTOR=1

# ----- data stores --------------------------------------------------------------
DATABASE_URL=postgresql://tugla:tugla@localhost:5432/tugla?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_USER=tugla
POSTGRES_PASSWORD=tugla
POSTGRES_DB=tugla

# ----- secrets (REQUIRED in production; API refuses to boot without them) -------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SESSION_ENCRYPTION_KEY=
INTERNAL_API_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ----- bootstrap admin (created/updated by `pnpm db:seed`) ----------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ----- OAuth sign-in (leave empty until provider accounts exist) ----------------
# Google Cloud Console -> OAuth client (Web + Android/iOS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same client id, exposed to the browser so Google can render its button.
# Authorised JavaScript origin: https://tugla.fun
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Apple Developer -> Identifiers + Sign in with Apple key
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ----- email delivery -----------------------------------------------------------
# smtp = real delivery, log = print to API log (development), disabled = off
MAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tuğla.fun <no-reply@tugla.fun>

# ----- replay/object storage ----------------------------------------------------
# database = store replays in PostgreSQL (default, no external account)
# s3       = any S3-compatible endpoint (MinIO below, R2, B2, AWS)
STORAGE_PROVIDER=database
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public base URL for avatar images; leave empty to serve them through the API.
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
REPLAY_RETENTION_DAYS=90

# ----- monetisation (feature-flagged; off until keys exist) ---------------------
ADS_ENABLED=false
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- site analytics: Analyze Your Site (Siteni Analiz Et), self-hosted ---------
# Public URL of the dashboard; empty = no tracker on any page.
# Variable names follow the dashboard's own: it reads ANALYZE_*, never ANALYTICS_*.
NEXT_PUBLIC_ANALYZE_URL=
NEXT_PUBLIC_ANALYZE_SITE=tugla.fun
# Only needed when running the bundled service (compose profile "analytics").
ANALYZE_REPO=https://github.com/emindemirciai/Analyze.Your.Site-Siteni-Analiz-Et-.git
ANALYZE_REF=main
ANALYZE_MAX_EVENTS=20000

# ----- observability -------------------------------------------------------------
SENTRY_DSN=

# ----- mobile (Capacitor) --------------------------------------------------------
MOBILE_APP_ID=fun.tugla.app
# Production PWA URL that the native shells load:
CAPACITOR_SERVER_URL=

# ----- discoverability: SEO / GEO / AEO ------------------------------------------
# Default UI + metadata language (tr | en)
DEFAULT_LOCALE=tr
# Force indexing outside production (staging stays noindex unless set to true)
SEO_INDEXABLE=false
# Allow AI/answer-engine crawlers (GPTBot, ClaudeBot, PerplexityBot, ...) in robots.txt
AI_CRAWLERS_ALLOWED=true
# Optional social handle used for twitter:site / twitter:creator (e.g. @tuglagame)
# Rights holder in the source notice and copyright metadata.
SITE_OWNER=Emin DEMİRCİ
# Same value, exposed to the browser for the footer and the view-source notice.
NEXT_PUBLIC_SITE_OWNER=Emin DEMİRCİ
SOCIAL_TWITTER=
# Search console verification tokens
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Refresh generated content after the API starts (upsert; accounts, progress and
# scores are untouched). Set to false if campaign levels are hand-edited in the
# admin panel and must survive deploys.
SEED_ON_DEPLOY=true

# ----- deployment (Dokploy webhook auto-deploy) ---------------------------------
DOKPLOY_WEBHOOK_URL=
DOKPLOY_WEBHOOK_SECRET=

# Brand and public URLs
APP_NAME=Tuğla
APP_SLUG=tugla
NODE_ENV=development
ROOT_DOMAIN=example.com
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Core services
DATABASE_URL=postgresql://tugla:tugla@localhost:5432/tugla?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SESSION_ENCRYPTION_KEY=
INTERNAL_API_KEY=

# Authentication providers (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Transactional email
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tuğla <no-reply@example.com>"

# Object storage: local MinIO, S3, R2 or B2
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=tugla
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional integrations
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Monetization is safely disabled until real accounts are configured
ADS_ENABLED=false
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
ADMOB_REWARDED_ANDROID_ID=
ADMOB_REWARDED_IOS_ID=
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=

# Operations
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
TRUST_PROXY=1
LOG_LEVEL=info

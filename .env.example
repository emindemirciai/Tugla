# ==============================================================================
# Pulse — environment template
# Copy to .env and fill in. Blank values are treated as "not configured":
# the related feature stays off and the UI says so instead of faking it.
# Generate strong secrets with: node scripts/generate-secrets.mjs
# ==============================================================================

# ----- identity / branding (single source for the whole product) --------------
APP_NAME=Pulse
APP_SLUG=pulse
APP_TAGLINE=Break the grid
ROOT_DOMAIN=localhost
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
# Values inlined into browser bundles at build time:
NEXT_PUBLIC_APP_NAME=Pulse
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_ENVIRONMENT=development

# ----- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Dokploy/Traefik = 1)
TRUST_PROXY=0

# ----- data stores --------------------------------------------------------------
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse

# ----- secrets (REQUIRED in production; API refuses to boot without them) -------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SESSION_ENCRYPTION_KEY=
INTERNAL_API_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ----- bootstrap admin (created/updated by `pnpm db:seed`) ----------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ----- OAuth sign-in (leave empty until provider accounts exist) ----------------
# Google Cloud Console -> OAuth client (Web + Android/iOS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer -> Identifiers + Sign in with Apple key
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ----- email delivery -----------------------------------------------------------
# smtp = real delivery, log = print to API log (development), disabled = off
MAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Pulse <no-reply@localhost>

# ----- replay/object storage ----------------------------------------------------
# database = store replays in PostgreSQL (default, no external account)
# s3       = any S3-compatible endpoint (MinIO below, R2, B2, AWS)
STORAGE_PROVIDER=database
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
REPLAY_RETENTION_DAYS=90

# ----- monetisation (feature-flagged; off until keys exist) ---------------------
ADS_ENABLED=false
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- observability -------------------------------------------------------------
SENTRY_DSN=

# ----- mobile (Capacitor) --------------------------------------------------------
MOBILE_APP_ID=com.example.pulse
# Production PWA URL that the native shells load:
CAPACITOR_SERVER_URL=

# ----- deployment (Dokploy webhook auto-deploy) ---------------------------------
DOKPLOY_WEBHOOK_URL=
DOKPLOY_WEBHOOK_SECRET=

FROM node:24-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS dependencies
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/game-engine/package.json packages/game-engine/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS build
COPY tsconfig.base.json ./
# The app build scripts call ../../scripts/assert-build-env.mjs, so the folder
# has to exist inside the image as well.
COPY scripts scripts
COPY apps/web apps/web
COPY packages/shared packages/shared
COPY packages/game-engine packages/game-engine
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_NAME=Tuğla
ARG NEXT_PUBLIC_ENVIRONMENT=production
# Metadata (canonical URLs, JSON-LD, OG image) is baked while building the
# static pages, so branding and the site URL are build arguments as well.
ARG APP_NAME=Tuğla
ARG APP_TAGLINE=Break the grid
ARG WEB_URL=http://localhost:3000
ARG DEFAULT_LOCALE=tr
ARG NEXT_PUBLIC_ANALYTICS_URL=
ARG NEXT_PUBLIC_ANALYTICS_SITE=
ARG NEXT_PUBLIC_SITE_OWNER=
ARG NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_ENVIRONMENT=$NEXT_PUBLIC_ENVIRONMENT
ENV APP_NAME=$APP_NAME
ENV APP_TAGLINE=$APP_TAGLINE
ENV WEB_URL=$WEB_URL
ENV DEFAULT_LOCALE=$DEFAULT_LOCALE
ENV NEXT_PUBLIC_ANALYTICS_URL=$NEXT_PUBLIC_ANALYTICS_URL
ENV NEXT_PUBLIC_ANALYTICS_SITE=$NEXT_PUBLIC_ANALYTICS_SITE
ENV NEXT_PUBLIC_SITE_OWNER=$NEXT_PUBLIC_SITE_OWNER
ENV NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=$NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
RUN pnpm --filter @tugla/shared build \
 && pnpm --filter @tugla/game-engine build \
 && pnpm --filter @tugla/web build

FROM node:24-alpine AS runtime
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/public ./apps/web/public
RUN test -f /app/apps/web/server.js
USER nextjs
EXPOSE 3000
CMD ["node", "apps/web/server.js"]

FROM node:24-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS dependencies
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/game-engine/package.json packages/game-engine/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS build
COPY tsconfig.base.json ./
COPY apps/web apps/web
COPY packages/shared packages/shared
COPY packages/game-engine packages/game-engine
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_NAME=Pulse
ARG NEXT_PUBLIC_ENVIRONMENT=production
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_ENVIRONMENT=$NEXT_PUBLIC_ENVIRONMENT
RUN pnpm --filter @pulse/shared build \
 && pnpm --filter @pulse/game-engine build \
 && pnpm --filter @pulse/web build

FROM node:24-alpine AS runtime
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/static ./.next/static
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/public ./public
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]


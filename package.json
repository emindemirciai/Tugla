{
  "name": "tugla",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @tugla/web --filter @tugla/admin --filter @tugla/api dev",
    "lint": "prettier --check . && eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:load": "k6 run tests/load/smoke.js",
    "db:generate": "pnpm --filter @tugla/database generate",
    "db:migrate": "pnpm --filter @tugla/database migrate",
    "db:seed": "pnpm --filter @tugla/database seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rename-project": "node scripts/rename-project.mjs",
    "prepare": "simple-git-hooks",
    "test:e2e:api": "node scripts/e2e-api-smoke.mjs",
    "build:packages": "pnpm --filter @tugla/shared --filter @tugla/game-engine --filter @tugla/database build",
    "build:preview": "node scripts/build-preview.mjs",
    "release:version": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.13.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm format:check && pnpm typecheck && pnpm test"
  }
}
